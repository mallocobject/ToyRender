<?xml version="1.0" encoding="UTF-8"?>
<scene version="1.0">
    <!-- 相机靠近盒口，让康奈尔盒尽量占满视野 -->
    <camera position="0,0,1.5" target="0,0,5" up="0,1,0" fov="60" near="0.1" far="1000"/>

    <!-- Lambert 材质：经典康奈尔盒配色 + 两个球 -->
    <materials>
        <material name="white_wall" type="lambert" albedo="0.73,0.73,0.73"/>
        <material name="red_wall" type="lambert" albedo="0.65,0.05,0.05"/>
        <material name="green_wall" type="lambert" albedo="0.12,0.45,0.12"/>
        <material name="sphere_red" type="lambert" albedo="0.85,0.15,0.10"/>
        <material name="sphere_blue" type="lambert" albedo="0.15,0.30,0.85"/>
    </materials>

    <lights>
        <light type="point"
               position="0,1.6,5.3"
               color="1,1,1"
               attenuation="0,0,1"/>
    </lights>

    <objects>
        <!-- 白色部分：地板、天花板、后墙 -->
        <object name="white_walls" material="white_wall"
                position="0,0,0" rotation="0,0,0" scale="1,1,1">
            <!-- 地板 y=-2.05 -->
            <triangle v0="-2.75,-2.05,5" v1="-2.75,-2.05,9" v2="2.75,-2.05,9"/>
            <triangle v0="-2.75,-2.05,5" v1="2.75,-2.05,9" v2="2.75,-2.05,5"/>
            <!-- 天花板 y=2.05 -->
            <triangle v0="-2.75,2.05,5" v1="2.75,2.05,5" v2="2.75,2.05,9"/>
            <triangle v0="-2.75,2.05,5" v1="2.75,2.05,9" v2="-2.75,2.05,9"/>
            <!-- 后墙 z=9 -->
            <triangle v0="-2.75,-2.05,9" v1="-2.75,2.05,9" v2="2.75,2.05,9"/>
            <triangle v0="-2.75,-2.05,9" v1="2.75,2.05,9" v2="2.75,-2.05,9"/>
        </object>

        <!-- 左侧红墙 x=-2.75 -->
        <object name="red_wall" material="red_wall"
                position="0,0,0" rotation="0,0,0" scale="1,1,1">
            <triangle v0="-2.75,-2.05,5" v1="-2.75,2.05,5" v2="-2.75,2.05,9"/>
            <triangle v0="-2.75,-2.05,5" v1="-2.75,2.05,9" v2="-2.75,-2.05,9"/>
        </object>

        <!-- 右侧绿墙 x=2.75 -->
        <object name="green_wall" material="green_wall"
                position="0,0,0" rotation="0,0,0" scale="1,1,1">
            <triangle v0="2.75,-2.05,5" v1="2.75,-2.05,9" v2="2.75,2.05,9"/>
            <triangle v0="2.75,-2.05,5" v1="2.75,2.05,9" v2="2.75,2.05,5"/>
        </object>

        <!-- 球一：红色 Lambert，放在地板上 -->
        <object name="sphere_red" material="sphere_red"
                position="-1.2,-1.20,6.6" rotation="0,0,0" scale="1,1,1">
            <sphere radius="0.85"/>
        </object>

        <!-- 球二：蓝色 Lambert，放在地板上 -->
        <object name="sphere_blue" material="sphere_blue"
                position="1.3,-1.45,7.6" rotation="0,0,0" scale="1,1,1">
            <sphere radius="0.60"/>
        </object>
    </objects>
</scene>
